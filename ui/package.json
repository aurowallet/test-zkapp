{
  "name": "ui",
  "version": "4.0.1",
  "private": true,
  "packageManager": "npm@10.9.4",
  "engines": {
    "node": ">=22.19.5"
  },
  "scripts": {
    "dev": "next dev",
    "build": "STATIC_EXPORT=true next build",
    "build:server": "next build",
    "start": "next start",
    "preview": "npm run build:server && npm run start",
    "build:static": "npm run build",
    "lint": "next lint",
    "ts-watch": "tsc --noEmit --incremental --watch",
    "export": "npm run build",
    "deploy": "npm run build:static && touch out/.nojekyll && node ./ghp-postbuild && git add -f out && git commit -m \"Deploy gh-pages\" && cd .. && git subtree push --prefix ui/out origin gh-pages"
  },
  "dependencies": {
    "@aurowallet/mina-provider": "1.0.12",
    "@types/node": "20.12.12",
    "@types/react": "18.3.2",
    "@types/react-dom": "18.3.0",
    "coi-serviceworker": "^0.1.7",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.3",
    "mina-attestations": "0.5.0",
    "next": "14.2.3",
    "o1js": "3.1.0",
    "auro-e2e-test-zkapp": "file:../contracts",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "styled-components": "^6.0.8",
    "typescript": "5.4.5",
    "react-hot-toast": "2.5.2",
    "@walletconnect/sign-client": "^2.19.1",
    "@web3modal/standalone": "2.4.3"
  },
  "devDependencies": {
    "babel-plugin-styled-components": "2.1.4"
  }
}
